# Copy to server/.secrets/vps.env; chmod 600. Never commit the real file.
# Hex-only password avoids database URL escaping problems.
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
SPLITT_API_DOMAIN=api.your-domain.example
WEB_ORIGIN=https://splitt-dun.vercel.app
SPLITT_SELF_SERVE=true
# Include every builder-controlled proof wallet; wallet activity is not business adoption.
SPLITT_CONTROLLED_OWNERS=0x8bE0633d4fd1E8828338d4BC779dDb7dd2121fD1
ARC_RPC_URL=https://rpc.testnet.arc.io
OWNER_ADDRESS=0x8bE0633d4fd1E8828338d4BC779dDb7dd2121fD1
VAULT_ADDRESS=0x724c12bea7fab30e27a9b3f4d5581351ebc2c6c6
OPERATOR_ADDRESS=0xd0c362f85bd5452246999a53639c6c9ac0437063
VAULT_DEPLOYMENT_BLOCK=67179133
CIRCLE_WALLET_ID=33066062-abc7-5a74-b72b-5bab4d31fdfe
CIRCLE_API_KEY=configure-in-private-file
CIRCLE_ENTITY_SECRET=configure-in-private-file
# Optional server-only Anthropic configuration. Public calls have durable request caps.
# ANTHROPIC_API_KEY=configure-in-private-file
# PLANNER_PROVIDER=anthropic
# PLANNER_MODEL=claude-haiku-5-5
# PAYMENT_NOTE_MODEL=claude-haiku-5-5
# Optional durable server-only model key. Local Vercel OIDC tokens expire.
# PLANNER_PROVIDER=vercel-gateway
# PLANNER_MODEL=nvidia/nemotron-3.5-lightning-free
# AI_GATEWAY_API_KEY=configure-in-private-file

# Optional note reader; model output must pass evidence checks.
# PAYMENT_NOTE_MODEL=nvidia/nemotron-3.5-lightning-free
