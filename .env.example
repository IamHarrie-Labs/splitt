# Local fixture mode never sends money. Keep it local to this computer.
SPLITT_MODE=fixture
# Separate testnet workspace; requires all deployment, Circle and database gates.
# SPLITT_MODE=arc-testnet
# SPLITT_TESTNET_CONFIRM=arc-testnet
# Arc Mainnet workspace (V2 vault, multisig owner, Circle ARC wallet). Never reuse testnet values.
# SPLITT_MODE=arc-mainnet
# SPLITT_MAINNET_CONFIRM=arc-mainnet
# MAINNET_EXPECTED_RUNTIME_CODE_HASH=0x<audited vault runtime hash>
# The web build picks its network separately:
# NEXT_PUBLIC_SPLITT_NETWORK=testnet
# Public wallet-owned preview; requires PostgreSQL and a configured Circle operator.
# SPLITT_SELF_SERVE=true
# Classify builder-owned proof wallets separately from public testnet activity.
# SPLITT_CONTROLLED_OWNERS=0xYourBuilderWallet,0xYourControlledTestWallet
VAULT_DEPLOYMENT_BLOCK=
# file: default demo. postgres: durable fixtures with owner sign-in required.
SPLITT_STORAGE=file
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://splitt:splitt@localhost:5432/splitt
ARC_RPC_URL=https://rpc.testnet.arc.io
# Optional CCTP source RPC; the implemented route is testnet-only.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Optional in file mode. Required for Postgres. Use your public EOA address.
OWNER_ADDRESS=
# Enables signing in the non-executable Splitt Fixture domain; does not enable payouts.
VAULT_ADDRESS=
OPERATOR_ADDRESS=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
ANTHROPIC_API_KEY=
# Anthropic option: PLANNER_PROVIDER=anthropic, PLANNER_MODEL=claude-haiku-5-5,
# PAYMENT_NOTE_MODEL=claude-haiku-5-5. Keep credentials server-only.
PLANNER_MODEL=
# Optional gateway adapter; never put these credentials in NEXT_PUBLIC variables.
# PLANNER_PROVIDER=vercel-gateway
AI_GATEWAY_API_KEY=
# Sessions use random opaque tokens stored as hashes; no shared session secret needed.
# Optional public footer links (web build; put these in web/.env.local). Unset ones are hidden.
# NEXT_PUBLIC_PILOT_EMAIL=you@example.com   # switches the footer CTA to "Request a pilot session"
# NEXT_PUBLIC_REPO_URL=https://github.com/you/splitt
# NEXT_PUBLIC_X_URL=https://x.com/you

# Arc Mainnet is a separate production environment. These values are read only by
# `npm run mainnet:check`; the current application refuses mainnet execution.
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# MAINNET_OWNER_ADDRESS=0xReviewedMultisigOrPolicyOwner
# MAINNET_OPERATOR_ADDRESS=0xSeparateCircleArcOperator
# MAINNET_CIRCLE_WALLET_ID=
# MAINNET_VAULT_ADDRESS=
# MAINNET_AUDIT_REPORT_URL=https://example.com/audit.pdf
# MAINNET_RELEASE_COMMIT=40_character_reviewed_git_sha
# MAINNET_RELEASE_APPROVERS=names-or-change-control-reference
# MAINNET_EXPECTED_RUNTIME_CODE_HASH=0x64_hex_characters

# Optional payment-note reader, independent from allocation proposals.
# PAYMENT_NOTE_MODEL=nvidia/nemotron-3.5-lightning-free
# PLANNER_PROVIDER=vercel-gateway
# Use a stable server-only gateway key on a hosted worker; do not deploy a short-lived local OIDC token.
